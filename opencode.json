{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "bash": "ask"
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest", "--extension", "--caps=vision"],
      "enabled": true
    }
  },
  "agent": {
    "build": {
      "mode": "primary",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "plan": {
      "mode": "primary",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "security-reviewer": {
      "description": "Read-only reviewer for tenant isolation, authorization, and audit-trail regressions. Invoke before merging any change touching models, policies, middleware, or migrations.",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": "allow"
      },
      "prompt": "{file:./.opencode/agent/security-reviewer.md}"
    }
  }
}
